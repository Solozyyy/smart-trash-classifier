# ============================================
# SMART TRASH CLASSIFIER - CONFIGURATION
# ============================================

# ============================================
# 1️⃣  MÔI TRƯỜNG CHẠY
# ============================================
# Chọn môi trường: "colab" hoặc "local"
# - colab: Khi chạy trên Google Colab (có GPU miễn phí)
# - local: Khi chạy trên máy tính cá nhân
ENVIRONMENT=colab

# ============================================
# 2️⃣  GOOGLE COLAB (chỉ dùng khi ENVIRONMENT=colab)
# ============================================
# Đường dẫn file data.zip trên Google Drive
# Ví dụ: /content/drive/MyDrive/data.zip
COLAB_DRIVE_PATH=/content/drive/MyDrive/data.zip

# Thư mục chứa data sau khi giải nén
COLAB_DATA_DIR=/content/data_extracted/

# Thư mục chứa data đã cân bằng (sau preprocessing)
COLAB_BALANCED_DIR=/content/balanced_data/

# Thư mục lưu model weights
COLAB_WEIGHTS_DIR=/content/weights/

# ============================================
# 3️⃣  LOCAL (chỉ dùng khi ENVIRONMENT=local)
# ============================================

LOCAL_PROJECT_ROOT=your_project_path_here

# Tên thư mục chứa data (tính từ project root)
LOCAL_DATA_DIR=data

# Tên thư mục chứa data đã cân bằng
LOCAL_BALANCED_DIR=data_balanced

# Thư mục lưu model weights
LOCAL_WEIGHTS_DIR=weights

# ============================================
# 4️⃣  CẤU HÌNH TRAINING
# ============================================
# Số lượng ảnh mỗi class sau khi cân bằng
TARGET_IMAGES_PER_CLASS=2000

# Batch size (giảm xuống nếu thiếu RAM/VRAM)
BATCH_SIZE=32

# Số epoch train
EPOCHS=15

# Learning rate
LEARNING_RATE=0.001

# Kích thước ảnh input (224 là chuẩn cho ResNet)
IMAGE_SIZE=224

# ============================================
# 5️⃣  CẤU HÌNH MODEL (Tùy chọn nâng cao)
# ============================================
# Kiến trúc model: resnet18, resnet34, resnet50
MODEL_NAME=resnet18

# Dùng pretrained weights từ ImageNet (true/false)
PRETRAINED=true

# Random seed để kết quả có thể reproduce
RANDOM_SEED=42
